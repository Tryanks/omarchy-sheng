# Maintainer: archlinux-sheng
# 来源：ianchb/xiaomi-mipps-auth 的 arm64 release deb（0.21，外部包）
# 上游作业：workflow 用 `gh release download --pattern "*.deb"` 下到本包目录；source 要求文件名为
#   xiaomi-mipps-auth.deb（下载后改名或用 -O 指定）
# 原生化要点：只用 _shared/deb2pkg.sh 搬载荷，元数据（含依赖）全由本 PKGBUILD 声明，pkgver() 从
#   deb 的 control 读 Version；不写 .install（上游 postinst/postrm 只做 daemon-reload 与 udevadm
#   reload，pacman hook 已覆盖；服务 enable 交给 workflow，沿用 sheng-devauth 约定）
# 依赖映射（上游 control: python3, systemd, udev, util-linux, libglib2.0-bin）：libglib2.0-bin 提供的
#   gdbus 在 Arch 属 glib2，udev 归 systemd；若脚本引入 python-gobject 需补 depends（待实测确认）
pkgname=xiaomi-mipps-auth
pkgver=0.21
pkgrel=1
pkgdesc="Automatic Xiaomi MiPPS/PPS charger authentication for Xiaomi Pad 6S Pro (sheng)"
arch=('aarch64')
url="https://github.com/ianchb/xiaomi-mipps-auth"
license=('GPL-2.0-only')
depends=('python' 'systemd' 'util-linux' 'glib2')
options=('!strip' '!debug' '!lto')
source=("xiaomi-mipps-auth.deb")
sha256sums=('SKIP')

pkgver() {
  local tmp ctl v
  tmp="$(mktemp -d)"
  bsdtar -xf "$srcdir/xiaomi-mipps-auth.deb" -C "$tmp"
  ctl="$(find "$tmp" -maxdepth 1 -name 'control.tar*' | head -n1)"
  v="$(bsdtar -xOf "$ctl" ./control 2>/dev/null | awk -F': ' '/^Version:/{print $2; exit}')"
  rm -rf "$tmp"
  [[ -n "$v" ]] || { error "无法从 deb 读取 Version"; exit 1; }
  printf '%s' "${v//-/_}" | tr -cd '[:alnum:]._+'
}

package() {
  # shellcheck source=../_shared/deb2pkg.sh
  source "$startdir/../_shared/deb2pkg.sh"
  deb_extract_payload "$srcdir/xiaomi-mipps-auth.deb" "$pkgdir"

  # 校验：载荷必须带主程序与 udev 规则，否则多半是 release 资产选错/改名错
  [[ -x "$pkgdir/usr/libexec/xiaomi-mipps-auth" ]] || {
    error "载荷缺少 /usr/libexec/xiaomi-mipps-auth"
    exit 1
  }
  [[ -f "$pkgdir/usr/lib/udev/rules.d/90-xiaomi-mipps-auth.rules" ]] || {
    warning "载荷缺少 90-xiaomi-mipps-auth.rules，插拔充电器时服务不会被 udev 拉起"
  }
}
