# Maintainer: archlinux-sheng
# 鏉ユ簮锛歩anchb/sheng_devauth锛堟簮鐮侊級+ 鏈粨搴?payload/锛坰ystemd unit锛屽彇鑷?debian-sheng锛?# 浣滅敤锛氫笌鍐呮牳椹卞姩閰嶅悎瀹屾垚灏忕背瀹樻柟閿洏鐨勮璇侊紙qteesupplicant锛?# 鍘熺敓鍖栬鐐癸細
#   * 浜岃繘鍒剁敱 makepkg 鍦?build() 閲岀紪璇戯紙涓婃父 Debian 鐗堝悓鏍锋槸浠庢簮鐮?make锛夛紝
#     鑰屼笉鏄惉杩愮幇鎴愬彲鎵ц鏂囦欢
#   * Debian 鐨?postinst/prerm锛坋nable/start/stop/disable锛変笉鍐欏叆鍖呭唴锛?#     Arch 鎯緥鏄墦鍖呬笉鍚敤鏈嶅姟锛岀敱 workflow 鍦?chroot 鍐呮樉寮?systemctl enable
pkgname=sheng-devauth
pkgver=1.0
pkgrel=1
pkgdesc="Keyboard authentication daemon for the Xiaomi Pad 6S Pro official keyboard (sheng)"
arch=('aarch64')
url="https://github.com/ianchb/sheng_devauth"
license=('custom')
depends=('glibc')
makedepends=('git' 'base-devel')
options=('!strip' '!debug' '!lto')
source=("sheng-devauth::git+${SHENG_DEVAUTH_REPO:-https://github.com/ianchb/sheng_devauth}")
sha256sums=('SKIP')

build() {
  cd "$srcdir/sheng-devauth" || exit 1
  make
  [[ -f xiaomi_devauth ]] || { error "make 鏈骇鍑?xiaomi_devauth"; exit 1; }
  chmod 0755 xiaomi_devauth
}

package() {
  install -Dm755 "$srcdir/sheng-devauth/xiaomi_devauth" \
                 "$pkgdir/usr/bin/xiaomi_devauth"

  install -Dm644 "$startdir/payload/usr/lib/systemd/system/sheng-devauth.service" \
                 "$pkgdir/usr/lib/systemd/system/sheng-devauth.service"
  install -Dm644 "$startdir/payload/usr/lib/systemd/system/sheng-devauth.service.d/qtee.conf" \
                 "$pkgdir/usr/lib/systemd/system/sheng-devauth.service.d/qtee.conf"

  # depends 鐩墠鍙０鏄?glibc锛涘涓婃父寮曞叆鏂扮殑鍔ㄦ€佸簱渚濊禆锛岀敤浠ヤ笅鍛戒护鏍稿鍚庤ˉ鍏細
  #   ldd xiaomi_devauth | awk '/=>/ {print $1}'
}
