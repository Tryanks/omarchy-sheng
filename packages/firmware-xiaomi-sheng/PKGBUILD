# Maintainer: archlinux-sheng
# 来源：ianchb/sheng-firmware（master），对应 debian-sheng 的 firmware-xiaomi-sheng 包
# 原生化要点：
#   * Debian 版用 dpkg-deb 装到 /usr/lib/firmware，Arch 位置相同，无需改路径
#   * Debian 的 Conflicts/Replaces: linux-firmware 转为 pacman 的 conflicts/replaces，
#     并额外 provides=('linux-firmware')，这样依赖 linux-firmware 的包仍可解析
#   * 载荷由 workflow 预先打包成 sheng-firmware.tar.zst 放在本目录（支持自定义
#     firmware_repo / firmware_branch 输入），因此 makepkg 全程离线、可复现
#
# 注意（已核实的 ALARM 事实）：
#   * ALARM 的 `linux-firmware` 是**元包**，它把 `linux-firmware-qcom` 放在 optdepends
#     （不显式安装就没有 Adreno a740 的 zap/sqe 固件），并且拆出
#     `linux-firmware-atheros` 等分包，其中 ath12k/WCN7850/hw2.0/* 与本包路径重叠。
#     ALARM 的 rootfs tarball 预装了这个元包，而 pacman 在安装与本包冲突的元包时
#     不会顺带移除它的分包 → 会在安装本包时报文件冲突。
#     因此 scripts/in-chroot/30-device-packages.sh 会在安装前显式移除全部
#     linux-firmware* 包（与 Debian 侧「本包替换 linux-firmware」的语义一致）。
#   * 如果构建后发现 GPU（Adreno 740）缺少固件，说明 sheng-firmware 未包含
#     a740_sqe.fw / a740_zap.mbn，此时可在设备上单独安装 linux-firmware-qcom
#     （需确认与本包无文件路径重叠）。
pkgname=firmware-xiaomi-sheng
pkgver=1.0
pkgrel=1
pkgdesc="Firmware blobs & configs for Xiaomi Pad 6S Pro (sheng): WCN7850/ath12k, QCA BT, Cirrus DSP, touch, fingerprint"
arch=('aarch64')
url="https://github.com/ianchb/sheng-firmware"
license=('custom')
provides=('linux-firmware')
conflicts=('linux-firmware')
replaces=('linux-firmware')
options=('!strip' '!debug' '!lto')
source=("sheng-firmware.tar.zst")
sha256sums=('SKIP')

package() {
  [[ -f "$srcdir/fpcsheng.elf" || -d "$srcdir/ath12k" || -d "$srcdir/qcom" ]] || {
    error "载荷看起来不是 sheng-firmware 的内容，请先运行 scripts/stage-firmware.sh"
    exit 1
  }

  install -d "$pkgdir/usr/lib/firmware"
  cp -a --no-preserve=ownership "$srcdir/." "$pkgdir/usr/lib/firmware/"

  # 清掉 clone 带进来的版本控制/CI 元数据
  rm -rf "$pkgdir/usr/lib/firmware/.git" \
         "$pkgdir/usr/lib/firmware/.github" \
         "$pkgdir/usr/lib/firmware/.gitignore"
}
