# 基础系统包（Holo Core 底座，Valve/Collabora 的 Arch Linux aarch64 预览）
#
# 与 scripts/lists/base.list（ALARM 版）的差异 —— holo 的 core/extra 里没有这两个包：
#   * chrony   → 用 systemd 自带的 systemd-timesyncd 做时间同步（40-system-config.sh 负责启用）
#   * fprintd  → 指纹栈缺失，holo 模式下不安装 xiaomi-sheng-fingerprint（见 30-device-packages.sh）
# 其余包名与 ALARM 版一致（已逐个核对存在于 holo core/extra）。
systemd
# /sbin/init 由 systemd-sysvcompat 提供。Holo Core 底座（只有 systemd / systemd-libs）
# **不带**这个包，缺了它内核会 panic（No working init found）→ 实机开机全黑、背光不亮。
systemd-sysvcompat
sudo
kmod
e2fsprogs
vim
nano
wget
curl
ca-certificates
networkmanager
openssh
wpa_supplicant
dbus
iw
lm_sensors
wireless-regdb
net-tools
glibc
tzdata
# 音频（Arch 默认走 PipeWire；pipewire-alsa 提供 ALSA 兼容层）
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
# deb 重打包包的运行期依赖（设备包用 pacman -U 直接装，依赖必须已在系统里）
glib2
libyaml
util-linux
python
protobuf-c
libqmi
libmbim
libqrtr-glib
libgudev
polkit
libgusb
libpulse
