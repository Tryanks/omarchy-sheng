[Unit]
Description=Omarchy Sheng USB ADB shell (no pairing, USB only)
After=systemd-udevd.service local-fs.target
# Retry while the sheng USB driver is appearing; a boot-time condition would
# permanently skip this enabled service if the role switch were not ready yet.

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/omarchy-sheng/usb-adb.py
TimeoutStopSec=15
KillMode=mixed
Restart=on-failure
RestartSec=10
# The supervisor configures FunctionFS; adbd itself runs as the omarchy user.
UMask=0077
SocketBindDeny=any
# USB-only even if upstream attempts a TCP fallback. Outgoing networking still works.

[Install]
WantedBy=multi-user.target
